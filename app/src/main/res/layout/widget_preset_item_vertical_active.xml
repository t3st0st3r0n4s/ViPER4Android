<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_preset_item"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/widget_preset_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@null" />
        <TextView
        android:id="@+id/widget_preset_label"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />
        <ImageView
            android:id="@+id/widget_identity_icon"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="6dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/ic_widget_graphic_eq"
            android:contentDescription="@null"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_identity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:textSize="9sp"
            android:textColor="#FFFFFFFF" />
    </FrameLayout>
</LinearLayout>
